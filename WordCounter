    <script>
        // --- SELECCIÓN DE ELEMENTOS DEL DOM ---
        const themeToggleButton = document.getElementById('themeToggleButton');
        const languageSelector = document.getElementById('languageSelector');
        const textInput = document.getElementById('textInput');
        const wordCountEl = document.getElementById('wordCount');
        const lineCountEl = document.getElementById('lineCount');
        const paragraphCountEl = document.getElementById('paragraphCount');
        const clearButton = document.getElementById('clearButton');
        
        // Elementos para el divisor
        const divisorInput = document.getElementById('divisorInput');
        const dividedResultEl = document.getElementById('dividedResult');

        // --- DICCIONARIO DE TRADUCCIONES ---
        const translations = {
            es: { mainTitle: "Contador de Palabras, Líneas y Párrafos", subtitle: "Pega tu texto a continuación para analizarlo en tiempo real.", wordsLabel: "Palabras", linesLabel: "Líneas", paragraphsLabel: "Párrafos", clearButtonText: "Limpiar Texto", placeholderText: "Escribe o pega tu texto aquí...", divideByLabel: "Dividir palabras entre:", dividedResultLabel: "Resultado:", wordsUnitLabel: "palabras" },
            en: { mainTitle: "Word, Line, and Paragraph Counter", subtitle: "Paste your text below to analyze it in real time.", wordsLabel: "Words", linesLabel: "Lines", paragraphsLabel: "Paragraphs", clearButtonText: "Clear Text", placeholderText: "Type or paste your text here...", divideByLabel: "Divide words by:", dividedResultLabel: "Result:", wordsUnitLabel: "words" },
            pt: { mainTitle: "Contador de Palavras, Linhas e Parágrafos", subtitle: "Cole seu texto abaixo para analisá-lo em tempo real.", wordsLabel: "Palavras", linesLabel: "Linhas", paragraphsLabel: "Parágrafos", clearButtonText: "Limpar Texto", placeholderText: "Digite ou cole seu texto aqui...", divideByLabel: "Dividir palavras por:", dividedResultLabel: "Resultado:", wordsUnitLabel: "palavras" },
            de: { mainTitle: "Wort-, Zeilen- und Absatzzähler", subtitle: "Fügen Sie Ihren Text unten ein, um ihn in Echtzeit zu analysieren.", wordsLabel: "Wörter", linesLabel: "Zeilen", paragraphsLabel: "Absätze", clearButtonText: "Text löschen", placeholderText: "Geben oder fügen Sie Ihren Text hier ein...", divideByLabel: "Wörter teilen durch:", dividedResultLabel: "Ergebnis:", wordsUnitLabel: "wörter" },
            fr: { mainTitle: "Compteur de Mots, Lignes et Paragraphes", subtitle: "Collez votre texte ci-dessous pour l'analyser en temps réel.", wordsLabel: "Mots", linesLabel: "Lignes", paragraphsLabel: "Paragraphes", clearButtonText: "Effacer le Texte", placeholderText: "Saisissez ou collez votre texte ici...", divideByLabel: "Diviser les mots par:", dividedResultLabel: "Résultat:", wordsUnitLabel: "mots" },
            ru: { mainTitle: "Счетчик слов, строк и абзацев", subtitle: "Вставьте ваш текст ниже для анализа в реальном времени.", wordsLabel: "Слова", linesLabel: "Строки", paragraphsLabel: "Абзацы", clearButtonText: "Очистить текст", placeholderText: "Введите или вставьте ваш текст здесь...", divideByLabel: "Разделить слова на:", dividedResultLabel: "Результат:", wordsUnitLabel: "слов" },
            zh: { mainTitle: "单词、行和段落计数器", subtitle: "在下方粘贴您的文本以进行实时分析。", wordsLabel: "单词", linesLabel: "行数", paragraphsLabel: "段落", clearButtonText: "清除文本", placeholderText: "在此处输入或粘贴您的文本...", divideByLabel: "单词数除以:", dividedResultLabel: "结果:", wordsUnitLabel: "字" },
            pl: { mainTitle: "Licznik słów, wierszy i akapitów", subtitle: "Wklej tekst poniżej, aby przeanalizować go w czasie rzeczywistym.", wordsLabel: "Słowa", linesLabel: "Wiersze", paragraphsLabel: "Akapity", clearButtonText: "Wyczyść tekst", placeholderText: "Wpisz lub wklej tutaj swój tekst...", divideByLabel: "Podziel słowa przez:", dividedResultLabel: "Wynik:", wordsUnitLabel: "słów" },
        };

        // --- MANEJO DEL TEMA (MODO CLARO/OSCURO) ---
        const sunIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>`;
        const moonIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>`;

        function applyTheme(theme) {
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
                themeToggleButton.innerHTML = sunIcon;
                localStorage.setItem('theme', 'dark');
            } else {
                document.documentElement.classList.remove('dark');
                themeToggleButton.innerHTML = moonIcon;
                localStorage.setItem('theme', 'light');
            }
        }

        themeToggleButton.addEventListener('click', () => {
            const currentTheme = localStorage.getItem('theme') || 'dark';
            applyTheme(currentTheme === 'dark' ? 'light' : 'dark');
        });

        // --- LÓGICA DE TRADUCCIÓN ---
        function changeLanguage(lang) {
            const t = translations[lang];
            if (!t) return;

            document.querySelectorAll('[data-translate]').forEach(el => {
                const key = el.dataset.translate;
                if (t[key]) el.textContent = t[key];
            });

            document.querySelectorAll('[data-translate-placeholder]').forEach(el => {
                const key = el.dataset.translatePlaceholder;
                if (t[key]) el.placeholder = t[key];
            });
            localStorage.setItem('language', lang);
        }

        languageSelector.addEventListener('change', (e) => changeLanguage(e.target.value));

        // --- LÓGICA DEL CONTADOR ---
        function updateCounts() {
            const text = textInput.value;

            // 1. Conteo de Palabras
            const words = text.trim().split(/\s+/).filter(word => word !== '');
            const totalWords = words.length === 1 && words[0] === '' ? 0 : words.length;
            wordCountEl.textContent = totalWords;

            // 2. Conteo de Líneas
            const lines = text.split('\n');
            lineCountEl.textContent = text.length === 0 ? 0 : lines.length;

            // 3. Conteo de Párrafos
            const paragraphs = text.trim().split(/\n+/).filter(p => p.trim() !== '');
            paragraphCountEl.textContent = paragraphs.length === 1 && paragraphs[0] === '' ? 0 : paragraphs.length;
            
            // 4. Lógica de División
            const divisor = parseFloat(divisorInput.value); 
            if (divisor > 0) {
                const divisionResult = totalWords / divisor;
                // Usamos Math.round() para devolver un número entero sin decimales
                dividedResultEl.textContent = Math.round(divisionResult);
            } else {
                dividedResultEl.textContent = "0";
            }
        }

        // --- MANEJADORES DE EVENTOS ---
        textInput.addEventListener('input', updateCounts);
        divisorInput.addEventListener('input', updateCounts);

        clearButton.addEventListener('click', () => {
            textInput.value = '';
            divisorInput.value = '1'; 
            updateCounts(); 
        });

        // --- INICIALIZACIÓN ---
        document.addEventListener('DOMContentLoaded', () => {
            const preferredTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            applyTheme(preferredTheme);

            const preferredLanguage = localStorage.getItem('language') || 'es';
            languageSelector.value = preferredLanguage;
            changeLanguage(preferredLanguage);

            updateCounts(); 
        });

    </script>
